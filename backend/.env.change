# Sharing real .env variables for backend development things might change as per your system. Please adjust accordingly.
# Database Configuration
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/fleetwise
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=fleetwise

# JWT Configuration
SECRET_KEY=81b7dd93097b9fde73815d040badf018ba41c0c721009db8643f3cb276ccf5e3
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security Configuration
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

# Rate Limiting
RATE_LIMIT_LOGIN=25/minute
RATE_LIMIT_REGISTER=30/minute
RATE_LIMIT_API=100/minute
RATE_LIMIT_CHATBOT=50/minute

# Logging Configuration
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=10

# Session Settings
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_MINUTES=30

# Application Settings
APP_NAME=FleetWise
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173